{
  "author": "Quentin DI MEO",
  "name": "plume",
  "license": "MIT",
  "version": "1.13.0",
  "description": "Bandcamp extension: volume slider, hotkeys, loop modes, fullscreen mode, playback speed, waveform progress bar & beat visualizer.",
  "scripts": {
    "build": "node scripts/build.js --dev",
    "build:watch": "node scripts/build.js --dev --watch",
    "build:prod": "node scripts/build.js",
    "build:test": "node scripts/build.js --test",
    "clean": "rimraf dist build *.zip",
    "sync-version": "node scripts/sync-version.js",
    "package": "tsc --noEmit && pnpm build:prod && node scripts/package-deployer.js",
    "deploy": "pnpm clean && pnpm sync-version && pnpm package",
    "lint": "pnpm prettier && pnpm eslint",
    "eslint": "eslint src/**/*.ts",
    "eslint:fix": "eslint src/**/*.ts --fix",
    "prettier": "prettier --check 'src/**/*.{ts,js,json,css,html}' 'tests/**/*.ts'",
    "prettier:fix": "prettier --write 'src/**/*.{ts,js,json,css,html}' 'tests/**/*.ts'",
    "format": "pnpm prettier:fix && pnpm eslint:fix",
    "prepare": "tsc --noEmit && husky",
    "ship": "pnpm run deploy && node scripts/zip-sources.js",
    "test": "vitest run",
    "test:a11y": "pnpm test tests/a11y/",
    "test:cov": "pnpm test --coverage --coverage.skipFull",
    "test:report": "pnpm test:cov --reporter=verbose"
  },
  "keywords": [
    "bandcamp",
    "browser-extension",
    "chrome-extension",
    "firefox-addon",
    "typescript",
    "audio-player",
    "volume-control",
    "music-player",
    "bandcamp-enhancer",
    "seek-bar",
    "fullscreen",
    "web-extension",
    "manifest-v3"
  ],
  "dependencies": {
    "web-audio-beat-detector": "^8.2.39"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chrome": "^0.1.43",
    "@types/firefox-webext-browser": "^120.0.5",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.5",
    "axe-core": "^4.13.0",
    "esbuild": "^0.27.7",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "happy-dom": "^20.14.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "sass": "^1.104.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.0.0"
  },
  "lint-staged": {
    "src/**/*.{ts,js,json,css,html}": [
      "prettier --write"
    ],
    "tests/**/*.ts": [
      "prettier --write"
    ]
  }
}
